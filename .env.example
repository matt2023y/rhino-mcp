# Go fallback: only when the user .rhino-mcp directory has no local endpoint/config.
# Only the MCP server/tool reads this file; the Rhino plugin does not.
# Copy to .env; enter the running Rhino plugin's current endpoint values.
RHINO_HOST=127.0.0.1
RHINO_PORT=
RHINO_TOKEN=
RHINO_REQUEST_TIMEOUT_MS=120000
